@using Microsoft.AspNetCore.Identity
@using SchoolEquipmentHire.Data
@{
    ViewData["Title"] = "Home Page";
}

@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

<div>
    @if (!SignInManager.IsSignedIn(User))
    {

<div class="welcome-container">
    <h1 class="welcome-title">WELCOME!</h1>

    <div class="btn-container">
        <div class="btn-top">
            <p>dont have an account?</p>
            <a asp-area="Identity" asp-page="/Account/Register" class="signup-btn">SIGN UP</a>
        </div>
        <div class="btn-bottom">
            <p>already have an account?</p>
            <a asp-area="Identity" asp-page="/Account/Login" class="login-btn">LOGIN</a>
        </div>
    </div>
</div>

    }
    else
    {
        <!-- SIGNED IN UI -->
        <div class="student-dashboard">

            <!-- Header Rectangle -->
            <div class="dashboard-header">
                <h2>Welcome, Student!</h2>
                <p>Borrow sports equipment easily and responsibly.</p>

                <a href="/Equipment/Index" class="request-btn">
                    Request Equipment
                </a>
            </div>

            <!-- Quick Overview -->
            <div class="dashboard-boxes">

                <a href="/Equipment/Index" class="dash-box">
                    Available Equipments
                </a>

                <a href="/Bookings/MyBookings" class="dash-box">
                    My Bookings
                </a>

                <a href="/Equipment/MyEquipments" class="dash-box">
                    My Equipments
                </a>

            </div>

        </div>
    }
</div>

<style>
   /*SIGN UP PAGE*/
    body {
        font-family: 'Creato Display', 'Montserrat', sans-serif;
        background-color: #fff;
        margin: 0;
        padding: 0;
        text-align: center;
    }

    .welcome-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        position: relative;
    }

    .welcome-title {
        font-size: 4.5rem;
        color: black;
        font-weight: 750;
    }

    .welcome-subtitle {
        color: black; 
        font-size: 1.7rem;
        font-style: italic;
        margin-bottom: 0px;
    }

    .popular-text{
        font-size: 1.2rem; 
        font-weight: 500;
        font-style: italic;
        margin-top: 1rem;
    }

    .btn-container {
        border-radius: 20px;
        width: 500px;
        margin: 1rem auto; 
        font-size: 1.1rem;
        color: black;
        text-align: center;
        box-shadow: 0px 4px 12px rgba(0,0,0,0.1);
        overflow: hidden;
    }

    .btn-container p {
        margin: 0 0 15px; /* adds spacing above buttons */
        font-size: 1.1rem;
        font-style: italic;
        color: black;
        text-align: center;
    }

    .btn-container a {
        display: inline-block; 
        min-width: 180px;
        padding: 18px 20px;
        border-radius: 35px;
        font-size: 1.2rem;
        font-weight: bold;
        text-decoration: none;
        color: #000;
        transition: all 0.2s ease-in-out;
        text-align: center;
    }

    .btn-top {
        background: #cccccc;
        padding: 40px 20px;
    }

    .btn-top:hover {
        transform: translateY(-3px);
    }

    .btn-bottom {
        background: #e6e6e6;
        padding: 40px 20px;
    }

    .btn-container .signup-btn {
        background: #e6e6e6;
    }

    .btn-container .signup-btn:hover {
        background: #d6d6d6;
    }

    .btn-container .login-btn {
        background: #cccccc;
    }

    .btn-container .login-btn:hover {
        background: #bcbcbc;
    }

    /* STUDENT DASHBOARD */
    .student-dashboard {
        max-width: 700px;
        margin: 0 auto; /* Centers horizontally */
        padding-top: 60px;
        font-family: Arial, sans-serif;
        text-align: center;
    }

    .dashboard-header {
        background: #f5f5f5;
        padding: 35px;
        border-radius: 12px;
        margin-bottom: 30px;
        box-shadow: 0 3px 10px rgba(0,0,0,0.1);
    }

        .dashboard-header h2 {
            margin-bottom: 10px;
            font-size: 28px;
            font-weight: 700;
        }

        .dashboard-header p {
            margin-bottom: 20px;
            color: #555;
            font-size: 16px;
        }

    .request-btn {
        background: #000;
        color: #fff;
        padding: 12px 25px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        display: inline-block;
        transition: transform .2s ease, background .2s ease;
    }

        .request-btn:hover {
            background: #222;
            transform: translateY(-5px);
        }

    .dashboard-boxes {
        display: flex;
        justify-content: center;
        flex-direction: row;
        gap: 15px;
        margin-top: 20px;
    }

    .dash-box {
        background: #fff;
        color: #000;
        padding: 40px 20px; /* More height */
        border-radius: 10px;
        text-decoration: none;
        font-size: 20px;
        font-weight: 600;
        flex: 1; /* Equal width */
        height: 300px; /* Makes them tall vertical rectangles */
        display: flex; /* Center text vertically */
        align-items: center;
        justify-content: center;
        text-align: center;
        box-shadow: 0 3px 10px rgba(0,0,0,0.1);
        transition: transform .2s ease, background .2s ease;
    }

        .dash-box:hover {
            background: #f5f5f5;
            transform: translateY(-5px);
        }

</style>

<script src="~/js/carousel1.js"></script>
<link rel="stylesheet" href="~/css/carousel.css" />
