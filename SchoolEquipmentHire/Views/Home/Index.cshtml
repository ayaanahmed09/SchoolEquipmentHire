@using Microsoft.AspNetCore.Identity
@using SchoolEquipmentHire.Areas.Identity.Pages.Account
@{
    ViewData["Title"] = "Home Page";
}

@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

    @if (!SignInManager.IsSignedIn(User))
    {
        <div class="welcome-container">
            <img src="~/images/Avondale College Logo.png" alt="School Logo" class="school-logo" />
            <h1 class="welcome-title">Welcome Student</h1>
            <p class="welcome-subtitle">Hire Now</p>

            <div class="btn-container">
                <div class="btn-top">
                    <p>Don't have an account?</p>
                    <a asp-area="Identity" asp-page="/Account/Register" class="signup-btn">SIGN UP</a>
                </div>
                <div class="btn-bottom">
                    <p>Already have an account?</p>
                    <a asp-area="Identity" asp-page="/Account/Login" class="login-btn">LOGIN</a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="home-container text-center">
            <h1 class="main-title">Hire Equipment</h1>

            <form id="searchForm" asp-controller="Equipments" asp-action="AllEquipment" method="get" class="search-bar">
                <span class="search-icon"><i class="fas fa-search"></i></span>
                <input type="text" name="searchString" placeholder="Search Equipment" />
                <button type="submit" class="search-btn">Search</button>
            </form>
            </div>

            <!-- Bottom Buttons -->
            <div class="bottom-buttons">
                <div class="button-card">
                    <h3>ALL EQUIPMENT</h3>
                    <a asp-controller="EquipmentItems" asp-action="AllEquipment">
                        <img class="card-img-1" src="~/images/All Equipment.png" alt="All Equipment" />
                    </a>
                </div>
                <div class="button-card">
                    <h3>YOUR SPORT</h3>
                    <a asp-controller="EquipmentItems" asp-action="AllEquipment" asp-route-favourite="true">
                        <img class="card-img-2" src="~/images/ProfilePicture.png" alt="Sports" />

                    </a>
                </div>
                <div class="button-card">
                    <h3>HIRE IT AGAIN</h3>
                    <a asp-controller="EquipmentItems" asp-action="AllEquipment" asp-route-hireAgain="true">
                        <img class="card-img-3" src="~/images/Hire It Again.png" alt="Hire Again" />
                    </a>
                </div>
            </div>
    }
</div>

                        <style>
