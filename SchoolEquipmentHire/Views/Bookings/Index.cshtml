@model IEnumerable<SchoolEquipmentHire.Models.Booking>

<h1>Bookings</h1>

<div class="container mt-5">
    <h2 class="mb-4">Equipment Bookings</h2>

    <table class="table table-bordered table-hover booking-table">
        <thead class="table-light">
            <tr>
                <th>Booking ID</th>
                <th>Equipment</th>
                <th>Quantity</th>
                <th>Booking Date</th>
                <th>Return Date</th>
                <th>Status</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.BookingID</td>

                    <!--Equipment Name -->
                    <td>@item.Equipment.EquipmentName</td>

                    <!--Quantity from Equipment model -->
                    <td>@item.Equipment.Quantity</td>

                    <td>@item.User</td>
                    <td>@item.BookingDate.ToString("dd/MM/yyyy")</td>
                    <td>@item.ReturnDate.ToString("dd/MM/yyyy")</td>

                    <td>
                        <span class="status-badge @item.Status.ToLower()">
                            @item.Status
                        </span>
                    </td>

                    <td>
                        <a asp-action="MarkReturned" asp-route-id="@item.BookingID"
                           class="btn btn-sm btn-info">Mark Returned</a>
                    </td>

                </tr>
            }
        </tbody>
    </table>

    <p class="mt-3 text-muted">
        Please return the equipment on or before the return date.
    </p>
</div>
