@model IEnumerable<SchoolEquipmentHire.Models.Booking>

<div class="container py-4">
    <h2 class="mb-3">Equipment Bookings</h2>
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }
    <table class="table table-bordered table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>Booking ID</th>
                <th>Equipment</th>
                <th>Quantity</th>
                <th>Booked By</th>
                <th>Booking Date</th>
                <th>Return Date</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.BookingID</td>
                    <td>@item.Equipment?.EquipmentName</td>
                    <td>@item.Equipment.Quantity</td>
                    <!-- User / email -->
                    <td>@item.User?.Email</td>

                    <!-- Correct dates -->
                    <td>@item.BookingDate.ToString("dd/MM/yyyy")</td>
                    <td>@item.ReturnDate.ToString("dd/MM/yyyy")</td>

                    <!-- Status -->
                    <td>@item.Status</td>


                    <td>                 
                        @if (item.Status == "Pending")
                        {
                            <form asp-action="Approve"
                                  asp-route-id="@item.BookingID"
                                  method="post"
                                  class="d-inline">
                                <button type="submit" class="btn btn-sm btn-success">
                                    Approve
                                </button>
                            </form>

                            <form asp-action="Reject"
                                  asp-route-id="@item.BookingID"
                                  method="post"
                                  class="d-inline">
                                <button type="submit" class="btn btn-sm btn-danger">
                                    Reject
                                </button>
                            </form>
                        }

                        <a asp-action="Edit"
                           asp-route-id="@item.BookingID"
                           class="btn btn-sm btn-outline-primary">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.BookingID"
                           class="btn btn-sm btn-outline-danger">
                            Delete
                        </a>

                        @if (item.Status == "Available")
                        {
                            <button class="btn btn-sm btn-success" disabled>
                                Available
                            </button>
                        }
                        else if (item.Status == "Approved")
                        {
                            <form asp-action="MarkReturned"
                                  asp-route-id="@item.BookingID"
                                  method="post"
                                  class="d-inline">
                                <button type="submit"
                                        class="btn btn-sm btn-outline-success">
                                    Mark Returned
                                </button>
                            </form>
                        }
                        
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <p class="text-muted mt-2">
        Please return the equipment on or before the return date.
    </p>
</div>
