@model SchoolEquipmentHire.Models.Equipment

<div class="details-container">

    <h2>@Model.EquipmentName</h2>

    <img src="@Model.ImageUrl" alt="@Model.EquipmentName" class="equipment-image" />

    <p><strong>Category:</strong> @Model.Category</p>
    <p><strong>Available:</strong> @Model.Quantity</p>

<form asp-controller="Bookings" asp-action="Book" method="post">
    <input type="hidden" name="id" value="@Model.ID" />
    <button type="submit" class="btn btn-primary">Book Equipment</button>
</form>

    @* Show message below the (possibly disabled) button when equipment is fully booked *@
    @if (Model.Quantity <= 0 || TempData["ErrorMessage"] != null)
    {
        <div class="error-message">Equipment is fully booked.</div>
    }

    <a asp-action="Index" class="back-btn">Back to Equipments</a>
</div>

<style>
    .details-container {
        max-width: 600px;
        margin: 40px auto;
        font-family: Arial, sans-serif;
    }

    .back-btn {
        display: inline-block;
        margin-top: 20px;
        padding: 10px 16px;
        background: #007bff;
        color: white;
        border-radius: 6px;
        text-decoration: none;
    }

        .back-btn:hover {
            background: #0069d9;
        }

    .error-message {
        color: #a94442; /* bootstrap danger text color */
        background: #f2dede;
        border: 1px solid #ebccd1;
        padding: 10px 12px;
        border-radius: 4px;
        margin-top: 12px;
        font-weight: 600;
    }
</style>
