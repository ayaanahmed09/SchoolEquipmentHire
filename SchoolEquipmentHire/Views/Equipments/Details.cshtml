
@model SchoolEquipmentHire.Models.Equipment

<div class="details-container">

    <h2>@Model.EquipmentName</h2>

    @if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

    <div class="image-container">
        <img src="@Url.Content(Model.ImageUrl)"
             alt="@Model.EquipmentName"
             class="equipment-image" />
    </div>

    <p><strong>Category:</strong> @Model.Category</p>
    <p><strong>Available:</strong> @Model.Quantity</p>

    

<form asp-controller="Equipments"
      asp-action="Book"
      method="post">

    <input type="hidden" name="id" value="@Model.ID" />

<div class="mb-3">
            <label class="form-label">
                Quantity to Book
            </label>

            <select name="quantity" class="form-select">
                @for (int i = 1; i <= Math.Min(10, Model.Quantity); i++)
                {
                    <option value="@i">@i</option>
                }
            </select>
        </div>

<div class="mb-3">
    <label class="form-label">Booking Date and Time</label>
    <input type="datetime-local"
           id="bookingDate"
           name="bookingDate"
           class="form-control"
           min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"
           max="@DateTime.Now.AddDays(7).ToString("yyyy-MM-ddTHH:mm")"
           value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"
           required />
</div>

<div class="mb-3">
    <label class="form-label">Return Date and Time</label>
    <input type="datetime-local"
           id="returnDate"
           name="returnDate"
           class="form-control"
           min="@DateTime.Now.AddMinutes(1).ToString("yyyy-MM-ddTHH:mm")"
           max="@DateTime.Now.AddDays(7).ToString("yyyy-MM-ddTHH:mm")"
           required />
</div>

<button type="submit" class="btn btn-primary"
        disabled="@(Model.Quantity <= 0)">
    Book Equipment
</button>

</form>

<script>
    const bookingInput = document.getElementById("bookingDate");
    const returnInput = document.getElementById("returnDate");

    function updateReturnLimits() {
        if (!bookingInput.value) return;

        const booking = new Date(bookingInput.value);
        const minReturn = new Date(booking.getTime() + 60000);
        const maxReturn = new Date(booking.getTime() + 7 * 24 * 60 * 60 * 1000);

        function formatDate(date) {
            const pad = n => String(n).padStart(2, "0");
            return date.getFullYear() + "-" +
                pad(date.getMonth() + 1) + "-" +
                pad(date.getDate()) + "T" +
                pad(date.getHours()) + ":" +
                pad(date.getMinutes());
        }

        returnInput.min = formatDate(minReturn);
        returnInput.max = formatDate(maxReturn);

        if (returnInput.value &&
            (new Date(returnInput.value) < minReturn ||
             new Date(returnInput.value) > maxReturn)) {
            returnInput.value = "";
        }
    }

    bookingInput.addEventListener("change", updateReturnLimits);
    updateReturnLimits();
</script>



    @if (Model.Quantity <= 0 || TempData["ErrorMessage"] != null)
    {
        <div class="error-message">
            @(TempData["ErrorMessage"] ?? "Equipment is fully booked.")
        </div>
    }

    <a asp-action="Index" class="back-btn">
        Back to Equipments
    </a>
</div>

<style>
    .details-container {
        max-width: 600px;
        margin: 40px auto;
        padding: 0 20px;
        font-family: Arial, sans-serif;
    }

    .image-container {
        width: 100%;
        height: 350px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8f9fa;
        border-radius: 12px;
        overflow: hidden;
        margin: 20px 0;
        padding: 15px;
        box-sizing: border-box;
    }

    .equipment-image {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-position: center;
    }

    .back-btn {
    display: inline-block;
    margin-top: 20px;
    padding: 10px 16px;
    background: #007bff;
    color: white;
    border-radius: 6px;
    text-decoration: none;
    line-height: 1.5;
}

.back-btn:hover {
    background: #0069d9;
    color: white;
}

    .error-message {
        color: #a94442;
        background: #f2dede;
        border: 1px solid #ebccd1;
        padding: 10px 12px;
        border-radius: 4px;
        margin-top: 12px;
        font-weight: 600;
    }

    @@media (max-width: 576px) {
        .image-container {
            height: 260px;
        }
    }
</style>
