@model SchoolEquipmentHire.Models.Equipment

<div class="details-container">
    <h2>@Model.EquipmentName</h2>

    <p><strong>Category:</strong> @Model.Category</p>
    <p><strong>Available:</strong> @Model.Quantity</p>

    <a asp-action="Index" class="back-btn">Back to Equipments</a>
</div>

<style>
    .details-container {
        max-width: 600px;
        margin: 40px auto;
        font-family: Arial, sans-serif;
    }

    .back-btn {
        display: inline-block;
        margin-top: 20px;
        padding: 10px 16px;
        background: #007bff;
        color: white;
        border-radius: 6px;
        text-decoration: none;
    }

        .back-btn:hover {
            background: #0069d9;
        }
</style>
